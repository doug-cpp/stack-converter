# StackConverter Environment Configuration
# Copy this file to .env and fill in the required keys for your selected provider.

# Option A: Google Gemini API (used when provider is set to gemini_api)
GOOGLE_API_KEY=""

# Option B: Claude Code Subscription (used when provider is set to claude_subscription)
# IMPORTANT: Leave ANTHROPIC_API_KEY empty or unset when using claude_subscription
# so claude-agent-sdk uses your active `claude login` subscription session instead of API billing.
# ANTHROPIC_API_KEY=""

# Optional overrides
STACKCONVERTER_CONFIG="config.yaml"
STACKCONVERTER_CACHE_DIR="cache"
STACKCONVERTER_RUNS_DIR="runs"
